 140:Drivers/STM32C0xx_HAL_Driver/Src/stm32c0xx_hal.c **** {
 141:Drivers/STM32C0xx_HAL_Driver/Src/stm32c0xx_hal.c ****   HAL_StatusTypeDef  status = HAL_OK;
 142:Drivers/STM32C0xx_HAL_Driver/Src/stm32c0xx_hal.c **** 
 143:Drivers/STM32C0xx_HAL_Driver/Src/stm32c0xx_hal.c ****   /* Configure Flash prefetch, Instruction cache             */
 144:Drivers/STM32C0xx_HAL_Driver/Src/stm32c0xx_hal.c ****   /* Default configuration at reset is:                      */
 145:Drivers/STM32C0xx_HAL_Driver/Src/stm32c0xx_hal.c ****   /* - Prefetch disabled                                     */
 146:Drivers/STM32C0xx_HAL_Driver/Src/stm32c0xx_hal.c ****   /* - Instruction cache enabled                             */
