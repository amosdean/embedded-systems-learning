 103:Core/Src/motor.c **** void initMotor() {
 104:Core/Src/motor.c ****     uart_send_string("Initializing motors\r\n");
 105:Core/Src/motor.c ****     
 106:Core/Src/motor.c ****     RCC->IOPENR |= RCC_IOPENR_GPIOAEN; // latch and data
 107:Core/Src/motor.c ****     RCC->IOPENR |= RCC_IOPENR_GPIOBEN; // clock
 108:Core/Src/motor.c **** 
 109:Core/Src/motor.c ****     MOTORENABLE_PORT->MODER &= ~GPIO_MODER_MODE15_Msk;
 110:Core/Src/motor.c ****     MOTORENABLE_PORT->MODER |= GPIO_MODER_MODE15_0;
 111:Core/Src/motor.c ****     // MOTORENABLE_LOW;  // pull low to enable motors
 112:Core/Src/motor.c ****     MOTORENABLE_HIGH;  // pull low to enable motors
 113:Core/Src/motor.c **** 
 114:Core/Src/motor.c ****     MOTORLATCH_PORT->MODER &= ~GPIO_MODER_MODE6_Msk;
 115:Core/Src/motor.c ****     MOTORLATCH_PORT->MODER |= GPIO_MODER_MODE6_0;
 116:Core/Src/motor.c **** 
 117:Core/Src/motor.c ****     MOTORDATA_PORT->MODER &= ~GPIO_MODER_MODE9_Msk;
 118:Core/Src/motor.c ****     MOTORDATA_PORT->MODER |= GPIO_MODER_MODE9_0;
 119:Core/Src/motor.c **** 
 120:Core/Src/motor.c ****     MOTORCLK_PORT->MODER &= ~GPIO_MODER_MODE10_Msk;
 121:Core/Src/motor.c ****     MOTORCLK_PORT->MODER |= GPIO_MODER_MODE10_0;
 122:Core/Src/motor.c **** 
 123:Core/Src/motor.c ****     latchState = 0;
 124:Core/Src/motor.c ****     txLatch();
 125:Core/Src/motor.c **** 
 126:Core/Src/motor.c ****     for(int pos = 0; pos < 4; pos++) {
 127:Core/Src/motor.c ****         Motor *m = &motors[pos];
 128:Core/Src/motor.c ****         m->motornum = pos;
 129:Core/Src/motor.c ****         switch(pos) {
 130:Core/Src/motor.c ****             case FRONT_LEFT:
 131:Core/Src/motor.c ****                 latchState &= ~(1 << MOTOR1_A) & ~(1 << MOTOR1_B);
 132:Core/Src/motor.c ****                 break;
 133:Core/Src/motor.c ****             case FRONT_RIGHT:
 134:Core/Src/motor.c ****                 latchState &= ~(1 << MOTOR2_A) & ~(1 << MOTOR2_B);
 135:Core/Src/motor.c ****                 break;
 136:Core/Src/motor.c ****             case BACK_LEFT:
 137:Core/Src/motor.c ****                 latchState &= ~(1 << MOTOR3_A) & ~(1 << MOTOR3_B);
 138:Core/Src/motor.c ****                 break;
 139:Core/Src/motor.c ****             case BACK_RIGHT: 
 140:Core/Src/motor.c ****                 latchState &= ~(1 << MOTOR4_A) & ~(1 << MOTOR4_B);
 141:Core/Src/motor.c ****                 break;
 142:Core/Src/motor.c ****         }
 143:Core/Src/motor.c ****     }
 144:Core/Src/motor.c ****     txLatch();
 145:Core/Src/motor.c ****     initPWM(DEFAULT_FREQ);
 146:Core/Src/motor.c **** }
